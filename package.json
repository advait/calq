{
  "name": "calq",
  "version": "0.0.3",
  "repository": "git@github.com:advait/calq.git",
  "author": "Advait Shinde <advait.shinde@gmail.com>",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:spago": "spago build --watch",
    "test": "pnpm run build:spago && node --import ./engine/test/register.mjs ./engine/test/test-runner.mjs",
    "build": "pnpm run build:spago && vite build",
    "build:spago": "spago build",
    "serve": "vite preview",
    "clean": "rm -rf output dist",
    "lint:purs": "purs-tidy format-in-place 'engine/**/*.purs'",
    "lint:purs:ci": "purs-tidy check 'engine/**/*.purs'",
    "lint:ts": "eslint frontend e2e playwright.config.ts && prettier frontend e2e playwright.config.ts --write",
    "lint:ts:ci": "eslint frontend e2e playwright.config.ts && prettier frontend e2e playwright.config.ts --check",
    "lint": "pnpm run lint:purs && pnpm run lint:ts",
    "lint:ci": "pnpm run lint:purs:ci && pnpm run lint:ts:ci",
    "ci": "pnpm run build && pnpm run typecheck && pnpm run test && pnpm run lint:ci && pnpm run test:e2e",
    "gh-pages": "pnpm run clean && pnpm run build && echo 'calq.app' > dist/CNAME && gh-pages -d dist/",
    "typecheck": "tsc -p . && tsc -p e2e",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "decimal.js": "^10.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "gh-pages": "^6.3.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "purescript": "^0.15.16",
    "purs-tidy": "^0.11.1",
    "spago": "^1.0.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6"
  },
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26"
  }
}
