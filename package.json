{
  "name": "calq",
  "version": "0.0.3",
  "repository": "git@github.com:advait/calq.git",
  "author": "Advait Shinde <advait.shinde@gmail.com>",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "dev:spago": "spago build --watch",
    "test": "yarn build:spago && node --import ./engine/test/register.mjs ./engine/test/test-runner.mjs",
    "build": "yarn run build:spago && vite build",
    "build:spago": "spago build",
    "serve": "vite preview",
    "clean": "rm -rf output dist",
    "lint:purs": "purs-tidy format-in-place 'engine/**/*.purs'",
    "lint:purs:ci": "purs-tidy check 'engine/**/*.purs'",
    "lint:ts": "eslint frontend && prettier frontend --write",
    "lint:ts:ci": "eslint frontend && prettier frontend --check",
    "lint": "yarn run lint:purs && yarn run lint:ts",
    "lint:ci": "yarn run lint:purs:ci && yarn run lint:ts:ci",
    "ci": "yarn run build && yarn run test && yarn run lint:ci",
    "gh-pages": "yarn run clean && yarn run build && echo 'calq.app' > dist/CNAME && gh-pages -d dist/"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "decimal.js": "^10.6.0",
    "qs": "^6.17.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "gh-pages": "^6.3.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "purescript": "^0.15.16",
    "purs-tidy": "^0.11.1",
    "sass": "^1.108.0",
    "spago": "^1.0.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6"
  },
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=26"
  }
}
